	"max_version_min" : "9.0",
	"max_version_max" : "none",
	"os" : {
		"macintosh" : {
			"platform" : [ "x64", "aarch64" ],
			"min_version" : "11.0"
		},
		"windows" : {
			"platform" : [ "x64" ],
			"min_version" : "none"
		}
	},
	"package_extra" : {
