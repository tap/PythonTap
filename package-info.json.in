{
	"name" : "@C74_PACKAGE_NAME@",
	"version" : "@GIT_VERSION_MAJ@.@GIT_VERSION_MIN@.@GIT_VERSION_SUB@",
	"author" : "Timothy Place",
	"description" : "Write Max objects in Python: tap.python~ runs a Python class as an audio object, and tap.python as an object without audio that outputs what its methods return. Both make Max attributes and messages from the class's type hints, and reload it when it is saved.",
